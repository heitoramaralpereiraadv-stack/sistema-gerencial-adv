# Banco (Supabase, região São Paulo). Use a conexão "session pooler" ou direta.
DATABASE_URL="postgresql://postgres.<projeto>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://<projeto>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Somente no servidor; nunca com prefixo NEXT_PUBLIC
SUPABASE_SECRET_KEY="sb_secret_..."
NEXT_PUBLIC_SITE_URL="https://<endereco-do-sistema>"
# Testes de integração (Postgres local, dados fictícios)
DATABASE_URL_TESTE="postgresql://dev:dev@localhost:5432/sg_teste"
# Cifragem dos dados críticos (32 bytes em base64: openssl rand -base64 32). Guardar cópia com os sócios.
CHAVE_CIFRAGEM=""
CHAVE_INDICE=""
# SOMENTE desenvolvimento local com `next dev`: entra como este usuário sem Supabase.
# Ignorado em produção e na Vercel.
DEV_USUARIO_ID=""
